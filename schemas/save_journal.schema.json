{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cloud save transaction journal",
  "type": "object",
  "required": ["schema_version", "status", "last_transaction_id", "envelope"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"enum": ["idle", "prepared"]},
    "last_transaction_id": {"type": ["string", "null"]},
    "envelope": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["schema_version", "transaction_id", "campaign_id", "status", "write_order", "documents"],
          "properties": {
            "schema_version": {"const": 1},
            "transaction_id": {"type": "string", "minLength": 1},
            "campaign_id": {"type": "string", "minLength": 1},
            "status": {"const": "prepared"},
            "write_order": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            },
            "documents": {"type": "object", "minProperties": 1}
          },
          "additionalProperties": true
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "idle"}}},
      "then": {"properties": {"envelope": {"type": "null"}}}
    },
    {
      "if": {"properties": {"status": {"const": "prepared"}}},
      "then": {"properties": {"envelope": {"type": "object"}}}
    }
  ],
  "additionalProperties": false
}
